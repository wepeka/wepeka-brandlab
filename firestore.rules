rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per Firebase Auth user. plan/status/brandLimit/paidAt/
    // subscriptionExpiresAt are deliberately NOT in the allow-listed update
    // fields below — those only ever change via the Admin SDK (Midtrans
    // webhook in this repo's own /api functions, or wpk-dp's admin
    // dashboard), which bypasses these rules entirely. A signed-in user can
    // only ever mark their own account "paid" by actually paying.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Fase 2 of .claude/handoff-satu-akun.md: no client ever creates this
      // doc anymore. The 30-day trial is claimed server-side by wpk-dp's
      // Admin SDK (createTrialAccount(), from the Community trial-mission
      // flow) — the only signup path there is now — and a first-time
      // purchase with no prior trial is created by this repo's own Midtrans
      // webhook. Both bypass these rules entirely, so this is a hard "never
      // from the client", not a bound like the old 7-day-trial check it
      // replaces.
      allow create: if false;
      // A username change must point at a claim this account holds
      // (usernames/{name}, written in the same transaction by
      // js/account.js claimUsername) — never at someone else's handle.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'username'])
        && (!('username' in request.resource.data.diff(resource.data).affectedKeys())
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid);
      allow delete: if false;
    }

    // Shared counter behind the human-readable "account #N" id. Fase 2:
    // the only thing that used to bump this client-side (ensureAccountDoc's
    // create transaction in js/account.js) is gone — every accounts/{uid}
    // doc, and this counter along with it, is now reserved exclusively by
    // the Admin SDK (wpk-dp's createTrialAccount()/createAccount(), or this
    // repo's Midtrans webhook), which bypasses these rules entirely.
    // Read access closed (2026-10-06): no client reads it — only the Admin
    // SDK does (wpk-dp brandlab-db.ts, this repo's webhook/seed scripts) —
    // and any signed-in account could read the customer count off it.
    match /meta/accountCounter {
      allow read, write: if false;
    }

    // How many Founder Lifetime / Founder Ultimate slots are sold — shown
    // on the pricing page, including to logged-out visitors, hence public
    // read. Only api/midtrans/webhook.js (Admin SDK) ever writes it.
    match /meta/founderSlots {
      allow read: if true;
      allow write: if false;
    }

    // One doc per claimed "Wepeka Account" handle (@username) — doc id is
    // the lowercased username, its mere existence IS the uniqueness lock
    // (see claimUsername() in js/account.js). Anyone can read (handles are
    // meant to be shown/looked up), but a claim can only be created/held by
    // the uid it names, and can only ever be released (deleted) by its owner
    // — never overwritten to point at a different uid.
    //
    // One handle per account (audit S-25: any signed-in user could claim
    // as many handles as they liked). A claim is only created together
    // with accounts/{uid}.username moving to it, and only once the
    // account's previous claim is released in the same transaction; a
    // claim is only released once the account no longer uses it. This is
    // exactly what claimUsername() already does, so the app needs no change.
    function usernameAfter() {
      return getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('username', '');
    }
    function releasesOldClaim(username) {
      // New accounts are created with username: null (wepeka.com
      // brandlab-db.ts), so null and a missing field both mean "no old claim".
      let old = get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('username', null);
      return old == null || old == '' || old == username
        || !existsAfter(/databases/$(database)/documents/usernames/$(old));
    }
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && username.matches('^[a-z0-9_]{3,20}$')
        && usernameAfter() == username
        && releasesOldClaim(username);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && usernameAfter() != username;
    }

    // True only for a signed-in, PAID, non-suspended account — every write
    // below requires this in addition to owning the document. Excludes:
    // a free/never-paid account (status is "active" too, but plan=="free" —
    // without this check a free account could otherwise write brands/
    // content directly via the console even though the app itself never
    // lets them reach that code path), a lapsed monthly plan
    // (status=="readonly"), and an admin-deactivated account.
    // Mirrored in js/account.js writableByRules() (tested there) — keep the
    // two in sync.
    function accountActive() {
      return request.auth != null && activeAcc(get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data);
    }
    function activeAcc(acc) {
      return acc.status == 'active' && acc.plan != 'free'
        // A trial stops being writable the moment it ends, without waiting
        // for the daily cron (api/cron/check-expiry.js) to flip its status.
        && (acc.plan != 'trial' || acc.trialEndsAt > request.time.toMillis())
        // Same for a paid period (audit S-22): a lapsed subscription used to
        // keep writing until the cron's next run. No end date (Lifetime) or
        // a non-number = no limit, exactly like the cron and accessState().
        && paidTimeLeft(acc);
    }
    function paidTimeLeft(acc) {
      let ends = acc.get('subscriptionExpiresAt', null);
      return acc.plan == 'trial' || ends == null || !(ends is number) || ends > request.time.toMillis();
    }
    function isOwner(data) {
      return request.auth != null && data.ownerId == request.auth.uid;
    }

    // ---- Brand teams (Kerja Tim, 2026-10-22) -----------------------------
    // A brand owner can share brands with their own team. Membership lives
    // on the brand doc and only the server writes it (api/team.js, Admin
    // SDK): members {uid: {role, name, email, addedAt}} with role "editor"
    // (edits everything in the brand) or "viewer" (reads only), plus
    // memberIds [uid…] for the members' array-contains query. A member has
    // no accounts doc of their own for this: what they may write depends on
    // the OWNER's account being active (ownerActive), and everything they
    // create in the brand carries the owner's ownerId — except their own
    // chat threads (brainstorms), which stay private to them.
    // memberships/{uid} is the server-written index of a member's brands.
    function brandPath(id) {
      return /databases/$(database)/documents/brands/$(id);
    }
    function brandAt(id) {
      return get(brandPath(id)).data;
    }
    function brandAfter(id) {
      return getAfter(brandPath(id)).data;
    }
    function roleIn(b) {
      return request.auth == null ? ''
        : b.ownerId == request.auth.uid ? 'owner'
        : b.get('members', {}).get(request.auth.uid, {}).get('role', '');
    }
    function canRead(b) {
      return roleIn(b) in ['owner', 'editor', 'viewer'];
    }
    // An editor beyond the owner's seats (a smaller plan, a lapsed extra
    // seat) is paused by the server (members.{uid}.seatPaused, api/team.js
    // reconcileSeats): reads like a viewer until a seat frees up.
    function isEditor(b) {
      return roleIn(b) == 'editor'
        && b.get('members', {}).get(request.auth.uid, {}).get('seatPaused', false) != true;
    }
    function ownerActive(ownerUid) {
      return activeAcc(get(/databases/$(database)/documents/accounts/$(ownerUid)).data);
    }
    function isMember() {
      return request.auth != null && exists(/databases/$(database)/documents/memberships/$(request.auth.uid));
    }
    // Written only by the server, on the brand doc.
    function teamKeys() {
      return ['members', 'memberIds', 'ownerName'];
    }
    // What an editor may never change on the brand doc: the team, the
    // owner, the brand's life (archive/Trash), the Instagram/Facebook/ads
    // connections, the owner's own chats and the owner's rating settings.
    function ownerOnlyKeys() {
      return ['ownerId', 'members', 'memberIds', 'ownerName', 'archived', 'deletedAt', 'instagram', 'facebook', 'ads',
        'chatSessions', 'companion', 'teamSettings', 'createdAt'];
    }
    // A brand doc (content, campaign, series) a member may read: it sits in
    // a brand they're on and carries that brand's owner. Members query with
    // where(ownerId == brand owner) + where(brandId == brand), which is what
    // lets this be checked for a whole query.
    function memberReads(data) {
      return request.auth != null && canRead(brandAt(data.brandId)) && brandAt(data.brandId).ownerId == data.ownerId;
    }
    // An editor creating a brand doc: under a brand they edit, stamped with
    // that brand's owner, while the owner's plan is active.
    function editorCreates(data) {
      return request.auth != null && data.get('brandId', null) is string
        && isEditor(brandAt(data.brandId)) && data.ownerId == brandAt(data.brandId).ownerId && ownerActive(data.ownerId);
    }
    // An editor changing one: same brand, same owner, owner active.
    function editorUpdates() {
      return request.auth != null && resource.data.get('brandId', null) is string
        && isEditor(brandAt(resource.data.brandId)) && brandAt(resource.data.brandId).ownerId == resource.data.ownerId
        && keepsOwner() && request.resource.data.brandId == resource.data.brandId && ownerActive(resource.data.ownerId);
    }

    // Every `update` below also requires ownerId to stay unchanged —
    // without it, an owner could rewrite one of their own docs to hand it
    // (or the write access that comes with it) to a different uid, or use
    // it to probe/overwrite another account's doc id.
    function keepsOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // ---- Plan brand limit, enforced here (2026-10-06) -------------------
    // brandCounts/{uid} = { count, op, at }: how many of the account's
    // brands are ACTIVE (not archived, not in Trash) — what js/account.js
    // canCreateBrand/lockedBrandIds count. Only the server creates it (POST
    // /api/brands/recount, Admin SDK — also the repair path). The client
    // (js/store.js countOp) can only move it by one, in the same batch as a
    // brand write that changes that brand's activeness, naming the brand
    // (op) and stamped with the server time (at == request.time proves it's
    // the same request). EVERY inactive → active move (a new brand,
    // unarchive, restore from Trash) must keep the count within the plan's
    // limit. Each check is short-circuited so an ordinary brand edit (no
    // activeness change) costs no extra document read.
    function brandCountPath() {
      return /databases/$(database)/documents/brandCounts/$(request.auth.uid);
    }
    function brandActive(data) {
      return data.get('archived', false) != true && data.get('deletedAt', null) == null;
    }
    // The fields that decide activeness can only hold what the app writes
    // — deletedAt null/absent or a timestamp (ms > 0), archived a boolean
    // (or null/absent) — so the app's truthiness checks, brandActive above
    // and api/brands/recount.js agree on every value (0/false/"" would read
    // "active" in the app but "inactive" here). Checked on create and when
    // either field changes, so an old doc can still be edited otherwise.
    function validActivityFields(data) {
      return (data.get('deletedAt', null) == null || (data.deletedAt is number && data.deletedAt > 0))
        && (data.get('archived', null) == null || data.archived is bool);
    }
    function activityFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived', 'deletedAt']);
    }
    function countMovedFor(brandId) {
      let c = getAfter(brandCountPath()).data;
      return c.op == brandId && c.at == request.time;
    }
    // An account with no brandCounts doc yet is not limited — every account
    // today, until the new app's first load has the server recount it (and
    // whatever an old tab of the previous release writes before that).
    function countNotRequired() {
      return !existsAfter(brandCountPath());
    }
    // The plan's limit, as js/account.js brandLimitOf counts it: brandLimit
    // (missing = 3) + permanent slots + monthly slots. Rules can't drop the
    // lapsed monthly slots, so every listed slot counts — a little looser
    // than the app (nextBrandSlots reuses lapsed entries, so it stays small).
    function brandLimit() {
      let acc = get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
      let base = acc.get('brandLimit', 3);
      let extra = acc.get('extraBrands', 0);
      let slots = acc.get('brandSlotsUntil', []);
      return (base is int ? base : 3) + (extra is int && extra > 0 ? extra : 0) + (slots is list ? slots.size() : 0);
    }
    function isAdminUser() {
      return request.auth.uid == 'iSwfTtIQm6VkYoHFbI6wl7BzBF53';
    }

    function countWithinLimit() {
      return isAdminUser() || getAfter(brandCountPath()).data.count <= brandLimit();
    }

    match /brands/{id} {
      allow read: if isOwner(resource.data)
        || (request.auth != null && request.auth.uid in resource.data.get('memberIds', []));
      allow create: if isOwner(request.resource.data) && accountActive()
        && !request.resource.data.keys().hasAny(teamKeys())
        && validActivityFields(request.resource.data)
        && (!brandActive(request.resource.data) || countNotRequired()
            || (countMovedFor(id) && countWithinLimit()));
      allow update: if (isOwner(resource.data) && accountActive() && keepsOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(teamKeys())
        && (!activityFieldsChange() || validActivityFields(request.resource.data))
        && (brandActive(resource.data) == brandActive(request.resource.data) || countNotRequired()
            || (countMovedFor(id) && (brandActive(resource.data) || countWithinLimit()))))
        || (isEditor(resource.data) && keepsOwner() && ownerActive(resource.data.ownerId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerOnlyKeys()));
      allow delete: if isOwner(resource.data) && accountActive()
        && (!brandActive(resource.data) || countNotRequired() || countMovedFor(id));
    }

    // The counter itself: only ever moved together with the brand it names.
    function brandActiveBefore(brandId) {
      let path = /databases/$(database)/documents/brands/$(brandId);
      return exists(path) && get(path).data.ownerId == request.auth.uid && brandActive(get(path).data);
    }
    function brandActiveAfter(brandId) {
      let path = /databases/$(database)/documents/brands/$(brandId);
      return existsAfter(path) && getAfter(path).data.ownerId == request.auth.uid && brandActive(getAfter(path).data);
    }
    function validCountShape() {
      let d = request.resource.data;
      // lastRecountAt is the server's (recount throttle): kept, never set here.
      return d.keys().hasOnly(['count', 'op', 'at', 'lastRecountAt'])
        && !d.diff(resource.data).affectedKeys().hasAny(['lastRecountAt'])
        && d.count is int && d.count >= 0
        // A plain doc id: `op` goes into a path below, and a "/" could point
        // it at some other doc the account owns.
        && d.op is string && d.op.matches('[A-Za-z0-9_-]{1,128}') && d.at == request.time;
    }
    match /brandCounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Created (and repaired) only by the server's recount — never here.
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == uid && accountActive() && validCountShape()
        && ((!brandActiveBefore(request.resource.data.op) && brandActiveAfter(request.resource.data.op)
             && request.resource.data.count == resource.data.count + 1)
         || (brandActiveBefore(request.resource.data.op) && !brandActiveAfter(request.resource.data.op)
             && request.resource.data.count == resource.data.count - 1));
      allow delete: if false;
    }

    // ---- A brand's own subcollections (2026-10-06) ----------------------
    // Owner-only like everything else, through a denormalised ownerId (so
    // the owner's `where("ownerId","==",uid)` queries need no extra read),
    // and a create/update must also sit under a brand that same owner holds
    // (getAfter: the brand may be created in the same batch).
    function ownsBrandAfter(brandId) {
      return getAfter(/databases/$(database)/documents/brands/$(brandId)).data.ownerId == request.auth.uid;
    }
    // Uploaded files (js/brand-assets.js): one data URL per doc, capped so
    // the doc stays under Firestore's 1 MiB — mirrors ASSET_MAX_CHARS.
    // An editor writes them too, stamped with the brand owner (Kerja Tim).
    function editorWritesUnder(brandId) {
      return isEditor(brandAfter(brandId)) && request.resource.data.ownerId == brandAfter(brandId).ownerId
        && ownerActive(request.resource.data.ownerId);
    }
    match /brands/{brandId}/assets/{assetId} {
      allow read: if canRead(brandAt(brandId)) || isOwner(resource.data);
      allow create, update: if ((isOwner(request.resource.data) && accountActive() && ownsBrandAfter(brandId))
            || editorWritesUnder(brandId))
        && (resource == null || keepsOwner())
        && request.resource.data.brandId == brandId
        && assetId.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.keys().hasOnly(['ownerId', 'brandId', 'kind', 'dataUrl', 'name', 'createdAt', 'unusedSince'])
        // The sweep's two-phase mark (js/store.js sweepBrandAssets).
        && (request.resource.data.get('unusedSince', null) == null || request.resource.data.unusedSince is timestamp)
        && request.resource.data.kind in ['cover', 'logo', 'logo-secondary', 'logotype', 'mascot', 'moodboard', 'font']
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 1000000
        && request.resource.data.dataUrl.matches('data:[^,]*,.*')
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 200;
      allow delete: if isOwner(resource.data) && accountActive();
    }
    // Sales log (js/sales-tracker.js): one doc per month,
    // { ownerId, brandId, month, entries: [...] } — doc id "YYYY-MM" (or
    // "undated"). Old inline entries move here as they are, so the entries
    // themselves aren't shape-checked; Firestore's 1 MiB caps the doc.
    match /brands/{brandId}/sales/{month} {
      allow read: if canRead(brandAt(brandId)) || isOwner(resource.data);
      allow create, update: if ((isOwner(request.resource.data) && accountActive() && ownsBrandAfter(brandId))
            || editorWritesUnder(brandId))
        && (resource == null || keepsOwner())
        && request.resource.data.brandId == brandId
        && month.matches('[0-9]{4}-[0-9]{2}|undated')
        && request.resource.data.get('month', month) == month
        && request.resource.data.keys().hasOnly(['ownerId', 'brandId', 'month', 'entries'])
        && request.resource.data.entries is list;
      allow delete: if isOwner(resource.data) && accountActive();
    }
    // Papan (whiteboard, js/views/papan.js + js/papan/bridge.js): a brand's
    // boards and, below each board, its objects / comments / versions /
    // recaps / decks. Same team model as the brand's other subcollections:
    // the owner and editors write (stamped with the owner's ownerId), viewers
    // read. Unlike content, editors also delete: things leave a board all
    // the time. Objects are free-form canvas shapes, so beyond ids, owner
    // and brand/board keys only Firestore's 1 MiB doc cap applies.
    function boardWriter(brandId) {
      return (isOwner(request.resource.data) && accountActive() && ownsBrandAfter(brandId)) || editorWritesUnder(brandId);
    }
    function boardDeleter(brandId) {
      return (isOwner(resource.data) && accountActive())
        || (isEditor(brandAt(brandId)) && resource.data.ownerId == brandAt(brandId).ownerId && ownerActive(resource.data.ownerId));
    }
    match /brands/{brandId}/boards/{boardId} {
      allow read: if canRead(brandAt(brandId)) || isOwner(resource.data);
      allow create, update: if boardWriter(brandId)
        && (resource == null || keepsOwner())
        && request.resource.data.brandId == brandId
        && boardId.matches('[A-Za-z0-9_-]{1,64}');
      allow delete: if boardDeleter(brandId);
      match /{sub}/{docId} {
        allow read: if canRead(brandAt(brandId)) || isOwner(resource.data);
        allow create, update: if sub in ['objects', 'comments', 'versions', 'recaps', 'decks']
          && boardWriter(brandId)
          && (resource == null || keepsOwner())
          && request.resource.data.brandId == brandId
          && request.resource.data.boardId == boardId
          && docId.matches('[A-Za-z0-9_-]{1,64}');
        allow delete: if boardDeleter(brandId);
      }
    }
    match /content/{id} {
      allow read: if isOwner(resource.data) || memberReads(resource.data);
      allow create: if (isOwner(request.resource.data) && accountActive()) || editorCreates(request.resource.data);
      allow update: if (isOwner(resource.data) && accountActive() && keepsOwner()) || editorUpdates();
      // Only the owner deletes for good (Trash purge); a member's "delete"
      // is the soft one (deletedAt), an update.
      allow delete: if isOwner(resource.data) && accountActive();
    }
    match /campaigns/{id} {
      allow read: if isOwner(resource.data) || memberReads(resource.data);
      allow create: if (isOwner(request.resource.data) && accountActive()) || editorCreates(request.resource.data);
      allow update: if (isOwner(resource.data) && accountActive() && keepsOwner()) || editorUpdates();
      // Only the owner deletes for good (Trash purge); a member's "delete"
      // is the soft one (deletedAt), an update.
      allow delete: if isOwner(resource.data) && accountActive();
    }
    match /routineTemplate/{id} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && accountActive();
      allow update: if isOwner(resource.data) && accountActive() && keepsOwner();
      allow delete: if isOwner(resource.data) && accountActive();
    }
    // Recurring Content Series ("Content Series Memory") — a reusable AI
    // context (tone, structure, hooks, CTA) saved once per series and read
    // back on every new episode. Same owner isolation as everything else.
    match /series/{id} {
      allow read: if isOwner(resource.data) || memberReads(resource.data);
      allow create: if (isOwner(request.resource.data) && accountActive()) || editorCreates(request.resource.data);
      allow update: if (isOwner(resource.data) && accountActive() && keepsOwner()) || editorUpdates();
      // Only the owner deletes for good (Trash purge); a member's "delete"
      // is the soft one (deletedAt), an update.
      allow delete: if isOwner(resource.data) && accountActive();
    }
    // Chat threads (the Home "Teman Brand" companion thread today; the
    // Brainstorm partner's threads next) — one doc per thread so a message
    // never rewrites the brand doc. Same owner isolation as everything else.
    // Kerja Tim: a member's own threads in a shared brand are theirs alone
    // (ownerId = the member) and live while they edit that brand.
    function editorThread(data) {
      return data.get('brandId', null) is string && isEditor(brandAt(data.brandId))
        && ownerActive(brandAt(data.brandId).ownerId);
    }
    match /brainstorms/{id} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && (editorThread(request.resource.data) || accountActive());
      allow update: if isOwner(resource.data) && keepsOwner() && (editorThread(resource.data) || accountActive());
      allow delete: if isOwner(resource.data) && (isMember() || accountActive());
    }

    // Shared, non-secret AI config: which provider is active and whether AI
    // is enabled at all (see api/ai.js) — the actual API keys live in
    // Vercel env vars now, never in Firestore. Also carries `brandsBg`, the
    // seasonal background of the all-brands home. Any signed-in account
    // reads it; only the Wepeka team account (ADMIN_UIDS in js/account.js —
    // keep in sync) can change it.
    match /settings/main {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'iSwfTtIQm6VkYoHFbI6wl7BzBF53';
    }

    // Daily/monthly/trial AI quota counter, one per account — written only
    // by api/ai.js (Admin SDK, bypasses these rules) after a successful AI
    // call. The owner can read their own live count (see js/ai-usage.js);
    // nobody, including the owner, can write it directly — the whole point
    // is that the browser can no longer raise its own cap.
    // Kerja Tim: a member reads the owner's counter too — the team spends
    // the owner's credits (memberships/{uid}.ownerIds, server-written).
    match /aiUsage/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid
        || (isMember() && uid in get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.get('ownerIds', [])));
      allow write: if false;
    }

    // Pengumuman (js/announcements.js): what's new in Brandlab. Every
    // signed-in account reads; only the Wepeka team account (ADMIN_UIDS in
    // js/account.js — keep in sync) posts, edits or deletes.
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == 'iSwfTtIQm6VkYoHFbI6wl7BzBF53';
    }

    // One settings doc per account (doc id == uid) — platforms/formats/
    // thresholds etc. are private to that account, same read/write shape as
    // accounts/{uid} itself. (settings/main above never matches here: no
    // auth uid is ever the literal string "main".)
    match /settings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // A team member with no plan of their own keeps their own settings.
      allow write: if request.auth != null && request.auth.uid == uid && (isMember() || accountActive());
    }

    // 👍/👎 on AI results (js/ai-feedback.js → store.js recordAiFeedback).
    // Create-only for the signed-in author: the eval set is read later via
    // the Admin SDK, never by the client, and a rating is never edited.
    // Bounded (audit S-25): exactly the fields recordAiFeedback() writes,
    // at the sizes it already cuts them to — keep the two in sync — and
    // only from an account that can use AI at all.
    match /aiFeedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'uid', 'brandId', 'feature', 'prompt', 'output', 'rating', 'note', 'createdAt'])
        && request.resource.data.rating in ['up', 'down']
        && request.resource.data.feature is string && request.resource.data.feature.size() <= 80
        && request.resource.data.get('prompt', '') is string && request.resource.data.get('prompt', '').size() <= 8000
        && request.resource.data.get('output', '') is string && request.resource.data.get('output', '').size() <= 12000
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 1000
        && (request.resource.data.get('brandId', null) == null
            || (request.resource.data.brandId is string && request.resource.data.brandId.size() <= 128))
        && (isMember() || accountActive());
      allow read, update, delete: if false;
    }

    // ---- Kerja Tim: per-person and owner-only docs under a brand ---------
    // people/{uid}: what is private to one person in a brand (their chat
    // sessions, the Teman state) — readable and writable by that person
    // only, while they are on the brand.
    match /brands/{brandId}/people/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && canRead(brandAt(brandId));
      allow create, update: if request.auth != null && request.auth.uid == uid && canRead(brandAt(brandId))
        && request.resource.data.keys().hasOnly(['uid', 'brandId', 'chatSessions', 'companion', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // private/{doc}: the owner's Instagram/Facebook tokens, moved off the
    // brand doc (which members can read) — the owner only.
    match /brands/{brandId}/private/{docId} {
      allow read: if request.auth != null && brandAt(brandId).ownerId == request.auth.uid;
      allow create, update: if request.auth != null && brandAfter(brandId).ownerId == request.auth.uid && accountActive()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && brandAt(brandId).ownerId == request.auth.uid;
    }
    // Server-written (api/team.js): a member's brands, and the invites.
    match /memberships/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /invites/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /inviteCodes/{id} {
      allow read, write: if false;
    }
    // Per-email daily count of codes sent and wrong codes typed.
    match /codeGuards/{id} {
      allow read, write: if false;
    }

    // Payment history — written only by api/midtrans/webhook.js and read
    // only by wpk-dp's admin dashboard, both via the Admin SDK (bypasses
    // these rules entirely). Nothing in the Brandlab client ever needs to
    // touch this collection, so it's fully closed off here.
    match /payments/{id} {
      allow read, write: if false;
    }
  }
}
