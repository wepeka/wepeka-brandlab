{
  "name": "wepeka-brandlab",
  "private": true,
  "type": "module",
  "description": "Static ES-module app (served by serve.py locally, built by esbuild for production — see scripts/build.mjs) plus a small set of Vercel serverless functions under /api for the parts that can't live in client JS: Midtrans payment (create-transaction, webhook) and the daily subscription-expiry check.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import ./tests/setup.mjs --test \"tests/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-brandlab \"node --test \\\"tests/rules/*.test.mjs\\\"\"",
    "emu": "firebase emulators:start --only auth,firestore --project demo-brandlab",
    "emu:seed": "node --import ./tests/setup.mjs scripts/emu-seed.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-brandlab \"node --test \\\"tests/emu/*.test.mjs\\\"\""
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0"
  }
}
