# Midtrans (Settings -> Access Keys in the Midtrans dashboard)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Firebase Admin SDK service account (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key, project "wepeka-ba996").
# Used only by /api functions (never shipped to the browser).
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Guards api/cron/check-expiry.js from being triggered by anyone who finds
# the URL — any random long string, set the same value in Vercel's Cron
# Jobs settings so it sends it back as a Bearer token.
# CRON_SECRET=

# Meta Conversions API (server-side Purchase from the Midtrans webhook).
# Off while empty. Use the same pixel as js/meta-pixel.js and wepeka.com.
# META_PIXEL_ID=
# SECRET — Events Manager -> pixel -> Settings -> Conversions API -> Generate
# access token. Set as a Sensitive env var on Vercel, never commit it.
# META_CAPI_ACCESS_TOKEN=
# Only while checking Events Manager -> Test events; remove after.
# META_TEST_EVENT_CODE=
